# Backend API origin.
#
# Leave EMPTY for the same-origin setup (recommended): the app calls /api/...
# and /uploads/... on its own origin, which the Vercel rewrites (production) and
# the Vite dev proxy (local) forward to the backend. This keeps the auth cookie
# first-party so it can stay sameSite=strict.
#
# Set it to an absolute URL ONLY if you deliberately run the backend on a
# different origin -- that also requires CORS and sameSite=none on the cookie.
VITE_BACKEND_API_URL=

# Where the Vite dev proxy forwards /api and /uploads during `npm run dev`.
# Defaults to http://localhost:3000 when unset.
DEV_BACKEND_ORIGIN=http://localhost:3000

# TinyMCE Rich Text Editor
# Get a key at https://www.tiny.cloud/ and restrict it to your domains
VITE_TINYMCE_API_KEY=your-tinymce-api-key-here
