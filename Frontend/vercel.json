{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-BACKEND-HOST/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://REPLACE-WITH-BACKEND-HOST/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
