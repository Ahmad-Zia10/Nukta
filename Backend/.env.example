PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Hugging Face API Configuration
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Optional: override the summarization model or full endpoint URL.
# Defaults to facebook/bart-large-cnn on the Inference Providers router.
# HUGGINGFACE_SUMMARIZATION_MODEL=facebook/bart-large-cnn
# HUGGINGFACE_SUMMARIZATION_URL=

# Cloudinary image storage
# Copy CLOUDINARY_URL from your Cloudinary dashboard (Product Environment
# Credentials). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your-key:your-secret@your-cloud-name

# Optional: folder images are stored under (defaults to nukta/posts)
# CLOUDINARY_FOLDER=nukta/posts
